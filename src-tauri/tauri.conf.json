{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitio",
  "version": "1.0.2",
  "identifier": "com.msg-lbo.gitio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gitio",
        "width": 1440,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQkJCNUIzMUZCNENDREIKUldUYnpMUWZzN1c3VXd2UE1lN1M4aS9kb3F4NHg5OVo3MWt1N2EvUVVXT00zdmwvSmV6YXU0UjcK",
      "endpoints": [
        "https://github.com/Msg-Lbo/gitio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
